# garmin-coach-mcp — environment configuration
#
# Copy to `.env` and edit:      cp .env.example .env
# Verify without starting up:   garmin-coach-mcp --check
#
# Precedence is: command-line flag  >  environment variable  >  default below.
# `.env` is git-ignored. Never commit real credentials.


# ---------------------------------------------------------------------------
# Garmin Connect account
# ---------------------------------------------------------------------------

# Account e-mail. Required for the very first login only: afterwards the OAuth
# tokens in GARMIN_TOKEN_DIR are reused and this can be removed.
GARMIN_EMAIL=you@example.com

# Account password. Same story — needed once, then delete it. It is never
# logged and never written to disk by this server.
GARMIN_PASSWORD=your-password

# Where the Garmin OAuth tokens are cached. Created on first login.
# Default: ~/.garmin-coach-mcp/tokens   (Docker image default: /data/tokens)
# The legacy name GARTH_TOKEN_DIR is still read, but is deprecated.
#GARMIN_TOKEN_DIR=~/.garmin-coach-mcp/tokens


# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------

# true  -> only read tools are registered; the workout create / schedule /
#          delete tools do not exist as far as the model is concerned.
# false -> full read/write surface.
# CLI equivalent: --read-only / --no-read-only. Default: false
#GARMIN_READ_ONLY=false


# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# stdio           - the default; what Claude Desktop / Claude Code launch.
# streamable-http - HTTP service (alias: http). Use for Docker and remote setups.
# sse             - legacy Server-Sent Events transport, for older clients.
# CLI equivalent: --transport. Default: stdio
#GARMIN_TRANSPORT=stdio

# Bind address for the http / sse transports. Use 0.0.0.0 inside a container,
# 127.0.0.1 on a workstation. CLI equivalent: --host. Default: 127.0.0.1
#GARMIN_HOST=127.0.0.1

# Bind port for the http / sse transports. `PORT` is also honoured, as a lower
# priority fallback for PaaS hosts. CLI equivalent: --port. Default: 8000
#GARMIN_PORT=8000


# ---------------------------------------------------------------------------
# Networking and diagnostics
# ---------------------------------------------------------------------------

# Per-request timeout against the Garmin Connect API, in seconds. Default: 20
#GARMIN_REQUEST_TIMEOUT=20

# Retry attempts for idempotent reads (writes are never blindly retried).
# Default: 3
#GARMIN_MAX_RETRIES=3

# DEBUG, INFO, WARNING, ERROR or CRITICAL. All logs go to stderr — stdout is
# reserved for MCP protocol traffic. CLI equivalent: --log-level. Default: INFO
#GARMIN_LOG_LEVEL=INFO
